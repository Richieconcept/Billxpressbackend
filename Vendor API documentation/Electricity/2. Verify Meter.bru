meta {
  name: 2. Verify Meter
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/vendor/electricity/verify-meter
  body: json
  auth: none
}

headers {
  Authorization: {{vendorApiKey}}
  Content-Type: application/json
}

body:json {
  {
    "disco": "IKEDC",
    "meterNumber": "12345678901",
    "meterType": "prepaid"
  }
}
