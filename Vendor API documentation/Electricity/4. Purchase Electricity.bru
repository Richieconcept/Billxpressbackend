meta {
  name: 4. Purchase Electricity
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/vendor/electricity/purchase
  body: json
  auth: none
}

headers {
  Authorization: {{vendorApiKey}}
  Content-Type: application/json
}

body:json {
  {
    "disco": "IKEDC",
    "meterNumber": "12345678901",
    "meterType": "prepaid",
    "phone": "{{customerPhone}}",
    "amount": 5000,
    "customerReference": "vendor-electricity-001"
  }
}

vars:pre-request {
  customerPhone: 08012345678
}
