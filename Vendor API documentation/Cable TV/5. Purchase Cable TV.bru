meta {
  name: 5. Purchase Cable TV
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/vendor/cable-tv/purchase
  body: json
  auth: none
}

headers {
  Authorization: {{vendorApiKey}}
  Content-Type: application/json
}

body:json {
  {
    "provider": "DSTV",
    "smartcardNumber": "1234567890",
    "packageCode": "dstv-padi",
    "phone": "{{customerPhone}}",
    "subscriptionType": "change",
    "customerReference": "vendor-cable-001"
  }
}

vars:pre-request {
  customerPhone: 08012345678
}
