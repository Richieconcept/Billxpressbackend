meta {
  name: 14. Admin Update Card Settings
  type: http
  seq: 14
}

patch {
  url: {{baseUrl}}/api/v1/admin/cards/settings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "isEnabled": true,
    "allowedBrands": ["VISA", "MASTERCARD"],
    "defaultBrand": "VISA",
    "providerCreationFee": { "percent": 0, "flat": 2 },
    "creationFeeUsd": { "percent": 0, "flat": 2 },
    "providerFundingFee": { "percent": 1, "flat": 0 },
    "fundingFee": { "percent": 1, "flat": 0 },
    "providerWithdrawalFee": { "percent": 0, "flat": 1 },
    "withdrawalFee": { "percent": 1, "flat": 0 },
    "fundingExchangeMarkupPercent": 1,
    "withdrawalExchangeMarkupPercent": 1,
    "monthlyMaintenanceFee": 1,
    "maintenanceGracePeriodDays": 3,
    "freezeOnMaintenanceFailure": true,
    "minimumFundingAmount": 1000,
    "maximumFundingAmount": 1000000,
    "minimumWithdrawalAmount": 1,
    "quoteTtlSeconds": 300
  }
}

docs {
  Provider fee `flat` values are USD. They represent Maplerad's cost.
  BillXpress `creationFeeUsd.flat` is USD. The backend converts it to NGN using
  the exact marked-up customer exchange rate displayed in the creation quote.
  For example, a `$2` fee at the displayed rate `1 USD = NGN 1,500` becomes
  `NGN 3,000`.

  The old `creationFee` field is deprecated and is not used for new card
  creation quotes. This prevents an old NGN value from accidentally being
  interpreted as USD.

  `fundingFee.flat` and `withdrawalFee.flat` remain NGN customer charges.
  `monthlyMaintenanceFee` is USD and is converted at the current Maplerad rate.
  Percentage values are entered as normal percentages, for example `1` = 1%.

  `maintenanceGracePeriodDays` controls how long an overdue card remains usable
  before it is frozen.

  `freezeOnMaintenanceFailure` should normally remain `true`. The backend uses
  Maplerad freeze/unfreeze so the same card can be restored after payment. It
  does not terminate cards for maintenance debt.
}
