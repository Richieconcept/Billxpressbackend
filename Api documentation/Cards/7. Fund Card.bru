meta {
  name: 7. Fund Card
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/cards/{{cardId}}/fund
  body: json
  auth: bearer
}

headers {
  Authorization: Bearer {{authToken}}
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "quoteId": "paste-card-quote-id",
    "transactionPin": "1234"
  }
}

vars:pre-request {
  authToken: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOiI2YTIwMzI5YjcyYWRhZjAyMjQwYmQ0YmQiLCJyb2xlIjoidmVuZG9yIiwiYXV0aFRpZXIiOiJ0aWVyXzMiLCJpYXQiOjE3ODM2NzM4ODAsImV4cCI6MTc4NDI3ODY4MH0.eI3s2ZweaHvTawvYfP4l7FGnb2HQRrEtFUNzUSkMRO4
}

docs {
  Debits the NGN wallet and funds the card from the Maplerad USD spend balance.
  The funding quote's exchange rate is used only to calculate the USD amount
  and NGN wallet debit; this endpoint does not execute a Maplerad `/fx`
  exchange during card funding.

  The wallet is refunded automatically if funding fails.
}
