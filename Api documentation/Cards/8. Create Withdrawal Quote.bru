meta {
  name: 8. Create Withdrawal Quote
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/cards/{{cardId}}/withdrawal-quote
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "amountUsd": 5
  }
}

docs {
  Returns the current Maplerad USD-to-NGN quote, fees, markup, and exact NGN
  amount that will be credited to the wallet.

  Display `quote.exchangeRate`. It is the effective customer payout rate after
  the configured withdrawal exchange markup. Do not display Maplerad's raw
  provider rate.

  Display `quote.fee` or the withdrawal charge in the quote summary as the
  total withdrawal fee charged to the user. This fee comes only from admin
  `withdrawalFee`. For a fixed withdrawal charge, admin should set:

  ```json
  {
    "withdrawalFee": {
      "percent": 0,
      "flat": 2000,
      "thresholdAmount": 0,
      "belowThresholdFlat": 0,
      "aboveThresholdPercent": 0
    }
  }
  ```

  The customer app should not calculate withdrawal fees itself. Show the values
  returned in the quote.
}
