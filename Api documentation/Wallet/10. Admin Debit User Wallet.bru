meta {
  name: 10. Admin Debit User Wallet
  type: http
  seq: 94
}

post {
  url: {{baseUrl}}/api/v1/admin/users/{{userId}}/wallet/debit
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{authToken}}
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "amount": "{{walletAmount}}",
    "walletType": "main",
    "reason": "Admin manual wallet debit"
  }
}

