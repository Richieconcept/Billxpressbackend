meta {
  name: 5. Redeem Referral Balance
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/wallet/referral/redeem
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{authToken}}
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "amount": "{{walletAmount}}",
    "transactionPin": "1234"
  }
}

