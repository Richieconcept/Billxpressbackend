meta {
  name: 1. Get Vendor Credentials
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/user/me/vendor/credentials
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{loginToken}}
}

docs {
  # Get Vendor Credentials

  Returns the logged-in vendor account and API credentials for the vendor dashboard/frontend.

  This endpoint uses the normal app login token:

  ```txt
  Authorization: Bearer {{loginToken}}
  ```

  Use the returned `vendorCredentials.apiKey` as `{{vendorApiKey}}` when calling the public vendor API routes under `/api/v1/vendor`.
}
