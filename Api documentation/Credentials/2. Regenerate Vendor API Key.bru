meta {
  name: 2. Regenerate Vendor API Key
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/user/me/vendor/api-key/regenerate
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{loginToken}}
}

docs {
  # Regenerate Vendor API Key

  Rotates the logged-in vendor's API key and returns the new key immediately.

  This endpoint uses the normal app login token:

  ```txt
  Authorization: Bearer {{loginToken}}
  ```

  After regeneration, the old vendor API key stops working. Update `{{vendorApiKey}}` in this Bruno environment and update any vendor backend configuration that uses the old key.
}
