meta {
  name: 15. Admin Update Transfer Settings
  type: http
  seq: 15
}

patch {
  url: {{baseUrl}}/api/v1/admin/transfers/settings
  body: json
  auth: bearer
}

headers {
  Authorization: Bearer {{authToken}}
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "flatFee": 25
  }
}

docs {
  # Admin Update Bank Transfer Settings

  Sets the fee added to every NGN Maplerad payout. The value is in naira.

  With `flatFee: 25`, sending N1,000 debits N1,025 while the beneficiary receives N1,000.
}
