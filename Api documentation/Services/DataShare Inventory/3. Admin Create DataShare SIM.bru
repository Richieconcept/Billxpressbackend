body:json {
  {
    "phoneNumber": "2348160424228",
    "label": "SIM A1",
    "groupName": "Group A",
    "activeFromDay": 1,
    "activeToDay": 10,
    "dailyLimitMb": 5120,
    "monthlyShareLimit": 10,
    "defaultReloadData": "11GB",
    "defaultReloadCost": 3500,
    "defaultReloadValidity": "30Days",
    "defaultReloadExpiresAfterDays": 30,
    "status": "active",
    "note": "First 10-day rotation SIM"
  }
}

docs {
  # Admin Create DataShare SIM

  Creates or updates one MTN datashare SIM. Use the same number format returned
  by 2Fast in transaction history, usually `234...`.

  ## Body Fields

  `phoneNumber`
  Required. The sender/sponsor SIM number. Digits only are stored.

  `label`
  Optional friendly name for admin UI.

  `groupName`
  Optional group name, for example `Group A`, `Group B`, or `Group C`.

  `activeFromDay`, `activeToDay`
  Optional monthly rotation days. These are for admin visibility and filtering.

  `dailyLimitMb`
  Optional. Default is `5120`, equal to 5GB.

  `monthlyShareLimit`
  Optional. Default is `10`.

  `defaultReloadData`
  Optional. The stock amount normally loaded on this SIM, for example `11GB`.

  `defaultReloadCost`
  Optional. The normal cost of that reload, for example `3500`.

  `defaultReloadValidity`
  Optional display label, for example `30Days`.

  `defaultReloadExpiresAfterDays`
  Optional. When quick reload is used, backend sets `expiresAt` this many days
  after the reload date.

  `status`
  `active`, `paused`, or `retired`.
}
