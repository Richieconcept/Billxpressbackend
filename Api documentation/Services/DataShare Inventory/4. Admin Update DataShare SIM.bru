meta {
  name: 4. Admin Update DataShare SIM
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/admin/services/data/datashare/sims/{{dataShareSimId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{authToken}}
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "label": "SIM A1",
    "groupName": "Group A",
    "activeFromDay": 1,
    "activeToDay": 10,
    "dailyLimitMb": 5120,
    "monthlyShareLimit": 10,
    "simBalance": "4.4GB",
    "defaultReloadData": "11GB",
    "defaultReloadCost": 3500,
    "defaultReloadValidity": "30Days",
    "defaultReloadExpiresAfterDays": 30,
    "status": "active",
    "note": ""
  }
}

vars:pre-request {
  dataShareSimId: paste_sim_id_here
}

docs {
  # Admin Update DataShare SIM

  Updates SIM metadata, group assignment, limits, or status.

  Use `status: "paused"` to temporarily keep the SIM in inventory while
  showing admins it should not be used. Use `retired` when the SIM is no longer
  in rotation.

  Admin may manually update `simBalance` when checking the SIM outside 2Fast.
  Successful 2Fast datashare purchases also update this field automatically
  when the provider response contains `Sponsor's New Balance`.
}
