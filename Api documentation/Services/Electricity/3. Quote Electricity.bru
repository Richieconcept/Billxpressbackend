meta {
  name: 3. Quote Electricity
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/services/electricity/quote
  body: json
  auth: bearer
}

headers {
  Authorization: Bearer {{authToken}}
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "amount": 2000
  }
}

docs {
  # Quote Electricity

  Use this endpoint to calculate what the user will pay after markup.

  ## Body

  `amount`
  Required. Electricity value in naira.

  ## Response

  ```json
  {
    "quote": {
      "amount": 2000,
      "sellingPrice": 2000,
      "profit": 0,
      "markupPercent": 0,
      "roundingMode": "ceil"
    }
  }
  ```
}
