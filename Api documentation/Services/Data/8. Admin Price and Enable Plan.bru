meta {
  name: 8. Admin Price and Enable Plan
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/api/v1/admin/services/data/plans/{{dataPlanId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{authToken}}
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "ourPrice": 250,
    "vendorPrice": 240,
    "isEnabled": true,
    "isHot": true,
    "dataType": "CORPORATE",
    "displayName": "MTN 1GB Daily Special",
    "displayDataType": "Daily",
    "displayValidity": "1 Day",
    "displayValidityDays": 1,
    "note": "Do not buy this plan if you are owing data.",
    "allowHostedSim": false,
    "allowWalletFallback": true
  }
}

